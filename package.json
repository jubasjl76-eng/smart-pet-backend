{
  "name": "smart-pet-backend",
  "version": "3.1.0",
  "description": "Unified Backend API for Smart Pet Ecosystem - Edge + Cloud",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && mkdir -p dist/database/migrations && cp src/database/migrations/*.sql dist/database/migrations/",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed-cli.ts",
    "prepare": "lefthook install || true",
    "openapi:dump": "JWT_SECRET=dump tsx src/openapi/dump.ts"
  },
  "dependencies": {
    "@jubasjl76-eng/mqtt-contract": "git+https://github.com/jubasjl76-eng/smart-pet-mqtt.git#mqtt-contract-v2.3.0",
    "@jubasjl76-eng/shared": "git+https://github.com/jubasjl76-eng/smart-pet-shared.git#shared-v0.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@sentry/node": "^10.74.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.15.0",
    "multer": "^2.3.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "lefthook": "^1.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^3.0.0"
  }
}
