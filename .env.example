# Smart Pet Backend - local feeder loop
# Copy to .env for host runs. Compose sets these for containers.

PORT=3000
NODE_ENV=development
BACKEND_MODE=cloud

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=smartpet
PG_USER=postgres
PG_PASSWORD=postgres

MQTT_URL=mqtt://localhost:1883

# CHANGE THIS outside local demo
JWT_SECRET=change-me
