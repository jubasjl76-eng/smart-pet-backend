# Smart Pet Backend — mirrors src/config/index.ts (Phase 12 config contract).
# `cp .env.example .env` is a working local start. Compose sets these for
# containers. A missing/invalid required var → boot prints the problem + exits.
# Grouped: public build-time · runtime non-secret · SECRET.

# ── public / build-time ────────────────────────────────────────────────
NODE_ENV=development            # development | staging | production | test
PORT=3000                       # the product path is 3000 only; other values warn
BACKEND_MODE=cloud              # cloud | local | edge
APP_BASE_URL=http://localhost:5173
BREEDER_KENNEL_SLUG=home
BREEDER_KENNEL_NAME=Home Kennel

# ── runtime non-secret ─────────────────────────────────────────────────
BREEDER_TICK_MS=60000
FEED_ACK_TIMEOUT_MS=8000

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=smartpet            # unset → smartpet (smartpet_edge when BACKEND_MODE=edge)
PG_USER=postgres

# The backend MQTT client (feeder command path + breeder engine). MQTT_URL wins;
# MQTT_BROKER is a legacy alias. Local dev broker is anonymous.
MQTT_URL=mqtt://localhost:1883
# MQTT_BROKER=
# MQTT_PUBLIC_URL=              # broker URL handed to a device on claim
MQTT_CLIENT_ID=smart-pet-backend
# MQTT_USER=                    # or MQTT_USERNAME
# MOSQUITTO_ACL_PATH=           # set → backend rewrites this ACL file on each claim

ACCESS_TTL=12h
REFRESH_TTL_DAYS=30
INVITE_TTL_DAYS=7
PAIRING_TTL_MIN=60

STORAGE_DRIVER=local            # local | s3
STORAGE_DIR=./data/uploads

# Boot seed (idempotent, runs every start). In prod, no password → not created.
SEED_OWNER_EMAIL=owner@smartpet.local
SEED_DEMO=true                  # adds a demo dam + sire, marks setup complete
# SEED_STAFF_EMAIL=
# SEED_RULES=false
# SEED_PENS=false

# Notifications (Phase 4) — unset channels are suppressed, never a hard failure.
# NOTIFY_EMAIL_FROM=alerts@yourkennel.example
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_FROM=+15550001234

# Public marketing site — ping it to refresh ahead of its ISR window.
# WEBSITE_REVALIDATE_URL=https://yoursite.example/api/revalidate

# ── SECRET (AWS Secrets Manager in cloud; SOPS+age for git non-prod) ────
JWT_SECRET=change-me           # REQUIRED. Boot fails if unset.
PG_PASSWORD=postgres
# MQTT_PASSWORD=
# RESEND_API_KEY=re_...         # email channel
# TWILIO_AUTH_TOKEN=...         # SMS channel
# WEBSITE_REVALIDATE_SECRET=change-me
# SEED_OWNER_PASSWORD=changeme
# SEED_STAFF_PASSWORD=

# Phase 12: ElastiCache — unused by the backend until Phase 20. "" = in-memory.
# REDIS_URL=
