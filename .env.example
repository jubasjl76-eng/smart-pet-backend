# Smart Pet Backend - Environment Variables
# Copy this to .env (DevOps owns gitignore / stop-tracking .env)

# Server
PORT=3000
NODE_ENV=development
BACKEND_MODE=cloud

# REQUIRED. Process will refuse to boot if unset. No hardcoded fallback.
JWT_SECRET=

# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=smartpet
PG_USER=postgres
PG_PASSWORD=postgres

# MQTT broker (local demo). Do not commit live passwords.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-pet-backend

# Seeded identities (local only). Register cannot mint staff.
SEED_OWNER_EMAIL=owner@localhost
SEED_OWNER_PASSWORD=owner-local-only
SEED_STAFF_EMAIL=staff@localhost
SEED_STAFF_PASSWORD=staff-local-only
