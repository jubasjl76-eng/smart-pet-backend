# Smart Pet Backend - local feeder loop
# Copy to .env for host runs. Compose sets these for containers.

# Server - product path is port 3000 only
PORT=3000
NODE_ENV=development
BACKEND_MODE=cloud

# JWT - REQUIRED. Process refuses to boot if unset. No hardcoded fallback.
# CHANGE THIS outside local demo
JWT_SECRET=change-me

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=smartpet
PG_USER=postgres
PG_PASSWORD=postgres

# MQTT broker used by the cloud feeder command path (backend client).
# Device credentials are minted on owner claim (username device:<deviceId>).
MQTT_BROKER=mqtt://localhost:1883
MQTT_USER=
MQTT_PASSWORD=

# ── Boot seed (src/database/seed.ts, runs every startup, idempotent) ─────
# Owner account. In production, no password = not created (no weak default).
SEED_OWNER_EMAIL=owner@smartpet.local
SEED_OWNER_PASSWORD=changeme
# Optional staff account.
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
# The 7 preset automation rules + 4 starter pens are seeded by default.
# SEED_RULES=false
# SEED_PENS=false
# Add a demo dam + sire and mark setup complete (for local demos).
SEED_DEMO=true

# Feed Now waits this many ms for device status ack
FEED_ACK_TIMEOUT_MS=8000

# ── Phase 1: auth, setup, device pairing ────────────────────────────────
# Short-lived access token; pair with a rotating refresh token.
ACCESS_TTL=12h
REFRESH_TTL_DAYS=30
# Staff/owner invite link lifetime.
INVITE_TTL_DAYS=7
# Device pairing code lifetime (minutes).
PAIRING_TTL_MIN=60
# Base URL of the web console — used to build invite accept links.
APP_BASE_URL=http://localhost:5173
# If set, the backend rewrites this Mosquitto ACL file on every device claim.
# Leave unset for local dev (broker is anonymous on a laptop).
# MOSQUITTO_ACL_PATH=/mosquitto/config/acl
# Public broker URL handed to a device on claim (falls back to MQTT_URL).
# MQTT_PUBLIC_URL=mqtt://localhost:1883

# ── Breeder platform (/api/breeder/*) ────────────────────────────────────
# One kennel (breeding operation) per deployment. slug is also the MQTT kennelId.
BREEDER_KENNEL_SLUG=home
BREEDER_KENNEL_NAME=Home Kennel
# Engine sweep interval (notifications, escalations, consumables, missed meds, offline).
BREEDER_TICK_MS=60000

# There is no global API_KEY / X-API-Key product path.
# Mongo / MONGODB_URI is leftover and unused (mqttConsumer.ts is quarantined).
