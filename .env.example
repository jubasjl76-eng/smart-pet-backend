# Smart Pet Backend - Environment Variables
# Copy this to .env and fill in your values. Do not commit live secrets.

# Server - product path is port 3000 only
PORT=3000
NODE_ENV=development

# JWT - REQUIRED. Process refuses to boot if unset. No hardcoded fallback.
JWT_SECRET=

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=smartpet
PG_USER=postgres
PG_PASSWORD=

# MQTT broker used by the cloud feeder command path (backend client).
# Device credentials are minted on owner claim (username device:<deviceId>).
MQTT_BROKER=mqtt://localhost:1883
MQTT_USER=
MQTT_PASSWORD=

# Seed identities (optional). Values are hashed at rest. Never commit live secrets.
# Register is localhost-only and always creates role=owner (never staff).
SEED_OWNER_EMAIL=owner@localhost
SEED_OWNER_PASSWORD=
SEED_STAFF_EMAIL=staff@localhost
SEED_STAFF_PASSWORD=

# Feed Now waits this many ms for device status ack
FEED_ACK_TIMEOUT_MS=8000

# There is no global API_KEY / X-API-Key product path.
# Mongo / MONGODB_URI is leftover and unused (mqttConsumer.ts is quarantined).
