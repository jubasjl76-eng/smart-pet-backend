# Smart Pet Backend - Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# MongoDB
# Local: mongodb://localhost:27017/smart-pet
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/smart-pet
MONGODB_URI=mongodb://localhost:27017/smart-pet

# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-change-this

# Optional: Expo for push notifications (future)
# EXPO_TOKEN=your-expo-token
